# Copy to .env (never commit it). Everything is optional.

# Hosted Chromium. Without it a local Chromium is launched.
BROWSERLESS_TOKEN=
# Any CDP endpoint that accepts ?token=… (default: Browserless SFO region).
# BROWSERLESS_ENDPOINT=wss://production-sfo.browserless.io

# Postgres with sql/schema.sql applied. Without it results go to OUTPUT_DIR as JSON.
DATABASE_URL=
# OUTPUT_DIR=output
